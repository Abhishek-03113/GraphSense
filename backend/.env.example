# All settings are read lazily (see src/config.py); only DATABASE_DSN is needed
# to run the API. Copy this file to .env and edit.

# --- Environment -------------------------------------------------------------
# dev | production. In production a CORS wildcard is ignored and the
# read-only database role is expected.
GRAPHSENSE_ENV=dev
LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------------
# Replace user, password, host, port, dbname with your local database values.
# DATABASE_URL is accepted as an alias (postgresql:// is rewritten to asyncpg).
DATABASE_DSN="postgresql+asyncpg://user:password@localhost:5432/dbname"
# SELECT-only role used for generated SQL (optional in dev).
# READONLY_DATABASE_DSN="postgresql+asyncpg://graphsense_ro:password@localhost:5432/dbname"

# Connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# --- Datasets ----------------------------------------------------------------
# Dataset used when a request does not name one (GRAPH_DATASET is the old name).
DEFAULT_DATASET="o2c"
# Extra directory of dataset packages (<id>/package.yaml), searched before the
# packages shipped in the repository. Keep customer packages outside the repo.
# PACKAGES_DIR=/srv/graphsense/packages
# Directory the operator keeps source data in; a package names a subdirectory.
# DATA_ROOT=/srv/graphsense/data

# --- Operator access ---------------------------------------------------------
# GRAPHSENSE_ADMIN_TOKEN=change-me

# --- Models ------------------------------------------------------------------
# Google Gemini API key for the conversational query interface (https://ai.google.dev)
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.0-flash"
# Embedding model id (GEMINI_EMBEDDING_MODEL is the old name). Confirm the
# current id with your provider; the vector size is stored with each row.
EMBEDDING_MODEL="text-embedding-004"

# --- Generated SQL limits ----------------------------------------------------
SQL_MAX_ROWS=200
SQL_STATEMENT_TIMEOUT_MS=5000

# --- Web ---------------------------------------------------------------------
# Comma separated origins. Empty means "*" in dev and none in production.
# CORS_ALLOW_ORIGINS=https://app.example.com
# 0 disables the in-process chat rate limiter.
CHAT_RATE_LIMIT_PER_MIN=0

# --- Ingestion / catalog -----------------------------------------------------
# Comma separated "module:attr" hooks run around the dataset swap.
# POST_INGEST_HOOKS=src.catalog.hooks:refresh_catalog,src.intelligence.knowledge.hooks:refresh_knowledge
PROFILE_SAMPLE_ROWS=50000
ENUM_MAX_DISTINCT=50

# --- Ask (conversational query) ----------------------------------------------
# Vector size to request from the embedding model (the size actually returned is
# stored with every embedded item). Empty keeps the model's default.
# EMBEDDING_DIMS=
LLM_TIMEOUT_S=30
# Times a failed generated query is sent back to the model for repair.
SQL_REPAIR_ATTEMPTS=2
# Result rows shown to the model when it writes the answer.
SYNTHESIS_MAX_ROWS=50
# Size budget of the retrieved context in a prompt, in characters.
RETRIEVAL_CONTEXT_CHARS=14000
# Questions and generated SQL are kept in app.query_log this long
# (purge now with: graphsense knowledge purge-log).
QUERY_LOG_ENABLED=true
QUERY_LOG_RETENTION_DAYS=90
# Behind a gateway the client address is in X-Forwarded-For; only trust it if the gateway sets it.
CHAT_RATE_LIMIT_TRUST_FORWARDED=false
